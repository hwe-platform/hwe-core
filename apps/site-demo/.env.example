# Postgres — local o Docker (ver README.md). Una base de datos propia
# para site-demo, no compartida con otros proyectos (DEC-003).
DATABASE_URI=postgres://postgres@127.0.0.1:5432/site-demo

# Secreto usado por Payload para firmar JWT. Genera uno propio en local,
# nunca reutilices el de otro entorno.
PAYLOAD_SECRET=replace-with-a-random-string

# URL pública del site, usada por Payload y por metadatos del frontend.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Opcionales. Usuario del panel con el que siembra scripts/seed-globals.mjs.
# Sin ellas el script pide las credenciales por argumento; con ellas lo puede
# lanzar un agente o la CI sin que nadie teclee una contraseña. Usa un usuario
# creado para el sembrado, no el personal de nadie.
PAYLOAD_SEED_EMAIL=
PAYLOAD_SEED_PASSWORD=
